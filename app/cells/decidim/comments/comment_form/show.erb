<%= append_stylesheet_pack_tag "decidim_idra", media: "all" %>
<!-- Modal styles now come from idra.scss -->

<%= form_for(form_object, url: decidim_comments.comments_path(order: order), method: :post, remote: true, html: { id: form_id }) do |form| %>
    <%= form.hidden_field :commentable_gid, id: nil %>
    <%= form.hidden_field :alignment, id: nil, class: "alignment-input" %>
    <%= comment_as_for(form) %>
  
    <div class="flex justify-between items-end mb-4">
      <label class="comment__form-label" for="<%= add_comment_id %>">
        <%= t("decidim.components.add_comment_form.form.body.label") %>
      </label>
      <span id="<%= add_comment_id %>-remaining-characters" class="remaining-character-count"></span>
    </div>
  
    <% if current_user %>
      <!-- Bottone per aprire il modal -->
      <button id="openCustomModalButton" type="button" style="padding: 0; display: flex; align-items: center; justify-content: center; width: 2.5em; height: 2.5em; background-color: transparent; border: none; cursor: pointer; margin-bottom: 1em;">
        <span style="font-size: 20px; color: #f1c232">★</span>
      </button>
    <% end %>
  
    <%= form.text_area(
      :body,
      id: add_comment_id,
      class: "w-full min-h-[160px]",
      maxlength: comments_max_length,
      required: true,
      placeholder: t("decidim.components.add_comment_form.form.body.placeholder"),
      label: false,
      data: { remaining_characters: "##{add_comment_id}-remaining-characters", input_emoji: true }
    ) %>
  
    <div class="comment__form-submit">
      <% if alignment_enabled? %>
        <%= render :opinion %>
      <% end %>
  
      <button type="submit" class="button button__sm button__secondary" disabled="disabled">
        <span>
          <% if reply? %>
            <%= t("decidim.components.add_comment_form.form.submit_reply") %>
          <% else %>
            <%= t("decidim.components.add_comment_form.form.submit_root_comment") %>
          <% end %>
        </span>
        <%= icon "chat-1-line" %>
      </button>
    </div>
  <% end %>
  
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      const openModalButton = document.getElementById("openCustomModalButton");
      const commentField = document.getElementById('<%= add_comment_id %>'); // Campo dei commenti
      if (!openModalButton || !commentField) return;
  
      const openModal = async () => {
        const existing = document.querySelector('[data-idra-editor-modal]');
        if (existing) {
          return existing;
        }
        const response = await fetch("/idra_modal_editor", { headers: { Accept: "text/html" } });
        if (!response.ok) throw new Error("Failed to load editor modal");
        const html = await response.text();
        const modalWrapper = document.createElement("div");
        modalWrapper.innerHTML = html.trim();
        const modalElement = modalWrapper.firstElementChild;
        if (!modalElement) return null;
        document.body.appendChild(modalElement);
        return modalElement;
      };
  
      const bindModal = (modalElement) => {
        if (modalElement.dataset.commentBound) return;
        modalElement.dataset.commentBound = "true";
        const searchBar = modalElement.querySelector('#idra-datasets-search');
        const list = modalElement.querySelector('#linksContainer');
  
        searchBar?.addEventListener('input', () => {
          const query = searchBar.value.toLowerCase();
          list?.querySelectorAll('.dataset-item').forEach((item) => {
            const text = item.textContent.toLowerCase();
            item.style.display = text.includes(query) ? 'flex' : 'none';
          });
        });
  
        list?.addEventListener('click', (event) => {
          const button = event.target.closest('.copy-button');
          if (!button) return;
          const url = button.dataset.url;
          const title = button.dataset.title;
          if (!url || !title) return;
          commentField.value += `${title} : ${url}\n`;
          button.textContent = 'Done';
          button.style.backgroundColor = 'transparent';
          button.style.color = 'gray';
          button.disabled = true;
          button.style.cursor = "not-allowed";
          button.style.opacity = "0.6";
          button.style.border = '1px solid grey';
        });
  
        modalElement.addEventListener('click', (event) => {
          if (event.target === modalElement) {
            modalElement.remove();
          }
        });
        modalElement.querySelector('[data-idra-modal-close]')?.addEventListener('click', () => modalElement.remove());
  
        if (window.Decidim && typeof window.Decidim.externalLinks === "function") {
          window.Decidim.externalLinks();
        }
      };
  
      openModalButton?.addEventListener('click', async () => {
        try {
          const modalElement = await openModal();
          if (!modalElement) return;
          bindModal(modalElement);
        } catch (error) {
          console.error(error);
        }
      });
    });
  </script>
  
