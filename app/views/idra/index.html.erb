<%= append_stylesheet_pack_tag "decidim_idra", media: "all" %>
<%= append_javascript_pack_tag "decidim_idra", defer: true %>

<div class="idra-page" data-idra-root data-saved-count="<%= @element_count %>">
  <div class="container mt-4">
    <div class="modal-overlay idra-modal-overlay" aria-hidden="true">
      <div class="modal idra-modal idra-modal-theme">
        <div id="partial-view-container">
          <%= render partial: "datasets_list" %>
        </div>
      </div>
    </div>

    <%= render partial: "delete_confirmation_modal" %>

    <%= render partial: "help_section" %>
    <%= render partial: "search_form" %>
    <%= render partial: "filters" %>

    <div class="row-body">
      <div class="col col-left">
        <%= render partial: "facets" %>
      </div>
      <div class="col col-right">
        <%= render partial: "top_buttons" %>
        <%= render partial: "search_results" %>
        <%= render partial: "buttons_bottom" %>
      </div>
    </div>
  </div>
</div>
